# Ermes - Enterprise Knowledge Hub
# Configuration file example

# Server
ERMES_HOST=127.0.0.1
ERMES_PORT=8502

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# Models
# qwen3:8b = default, balanced speed/quality (8B parameters, ~5GB RAM)
# qwen2.5:7b = alternative, slightly smaller (7B parameters, ~4.7GB RAM)
# qwen2.5:3b = faster, 40-60% speed improvement (3B parameters, ~2GB RAM)
ERMES_MODEL=qwen3:8b
ERMES_EMBED_MODEL=nomic-embed-text

# RAG
ERMES_SCORE_LOW=0.35
ERMES_SCORE_MED=0.55
ERMES_PROMPT_MAX_CHARS=2000
ERMES_LOG_RETENTION_DAYS=30

# Admin
ERMES_ADMIN_USERNAME=admin
ERMES_ADMIN_PASSWORD=CHANGE_ME
ERMES_ADMIN_MAX_UPLOAD_MB=50
ERMES_ENABLE_FORMULA_GENERATION=1

# API Security
# Genera una API key forte con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Se vuoto, l'API REST è disabilitata per sicurezza
ERMES_API_KEY=CHANGE_ME_TO_SECURE_API_KEY

# Audit Security (HMAC per integrità log)
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# Se vuoto, viene generata una secret temporanea (non persiste ai restart)
ERMES_AUDIT_SECRET=CHANGE_ME_TO_AUDIT_SECRET
