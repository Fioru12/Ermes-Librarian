# Ermes - Enterprise Knowledge Hub
# Configuration file example
# Copia in .env e modifica i valori

# ============================================================
# SERVER
# ============================================================
ERMES_HOST=127.0.0.1
ERMES_PORT=8502

# ============================================================
# OLLAMA (modello locale)
# ============================================================
OLLAMA_HOST=http://127.0.0.1:11434
# Host LLM ammessi dalla UI amministrativa. Aggiungi esplicitamente solo
# gateway aziendali approvati; non usare URL arbitrari.
# ERMES_PROVIDER_ALLOWED_HOSTS=openrouter.ai,api.openai.com,api.groq.com,api.anthropic.com,generativelanguage.googleapis.com,localhost,127.0.0.1,ollama

# ============================================================
# MODELLI LOCALI (usati se OPENROUTER_API_KEY non è configurata)
# ============================================================
# qwen3.5:9b = default, quality (9B parameters, ~6GB RAM)
# qwen3.5:4b = faster, 40-60% speed improvement (4B parameters, ~3GB RAM)
# bge-m3  = embedding model (multilingual, 1.5GB RAM)
# ATTENZIONE ai nomi: le variabili lette sono ERMES_DEFAULT_MODEL_ID e
# ERMES_EMBED_MODEL_ID. Fino al 10 settembre 2026 questo file documentava
# ERMES_MODEL ed ERMES_EMBED_MODEL, che non sono lette da nessuna riga di
# codice: chi le impostava restava sui valori predefiniti senza alcun segnale.
ERMES_DEFAULT_MODEL_ID=qwen3.5:9b
ERMES_EMBED_MODEL_ID=nomic-embed-text:latest
# Attiva embedding e ricerca semantica solo verso Ollama locale. Se il modello
# non e' disponibile, Ermes continua con la ricerca per parole.
# ERMES_LIBRARY_SEMANTIC_SEARCH=1

# ============================================================
# ASSISTENTE BIBLIOTECA (local-first)
# ============================================================
# evidence_only (default): nessun contenuto viene inviato a un LLM.
# local_ollama: invia solo i passaggi recuperati al server Ollama locale.
# approved_openrouter / approved_provider: cloud esplicito; richiede anche il consenso seguente.
ERMES_LIBRARY_ASSISTANT_MODE=evidence_only
# ERMES_LIBRARY_CLOUD_CONSENT=1
# ERMES_ASSISTANT_TIMEOUT_SEC=45

# ============================================================
# OPENROUTER (modello cloud — PRIMARY con fallback Ollama)
# ============================================================
# Nota: questa configurazione legacy non abilita il cloud per la biblioteca.
# Per l'assistente documentale usare ERMES_LIBRARY_ASSISTANT_MODE=
# approved_openrouter e confermare ERMES_LIBRARY_CLOUD_CONSENT=1.
# Se valorizzata, il sistema usa OpenRouter come PRIMARY con fallback
# automatico su Ollama locale in caso di errore/timeout.
#
# Comportamento:
#   - PRIMARY: OpenRouter (veloce, potente, cloud)
#   - FALLBACK: Ollama locale (se OpenRouter non raggiungibile)
#   - NO KEY: Usa direttamente Ollama locale
#
# Vantaggi OpenRouter:
#   - Velocità: 1-2 secondi invece di 180+ secondi su CPU
#   - Qualità: DeepSeek V3 / Claude 3.5 Sonnet >> Qwen locale
#   - Flessibilità: cambia modello senza reinstallare nulla
#
# Come ottenere una API key:
#   1. Vai su https://openrouter.ai/keys
#   2. Registrati (gratis, dà crediti iniziali)
#   3. Crea una nuova API key
#   4. Incollala qui sotto
#
# Costi stimati: ~$0.001 per richiesta (DeepSeek V3)
# Confronto: ~$0.01 per GPT-4o mini, ~$0.03 per Claude 3.5 Sonnet
#
# Per il bibliotecario: la chiave non attiva il cloud da sola. Devi confermare
# ERMES_LIBRARY_CLOUD_CONSENT=1 e selezionare OpenRouter o un provider approvato
# sulla singola biblioteca. Non esiste fallback automatico verso il cloud o tra provider.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================================
# LANGFUSE (tracing LLM — OBBLIGATORIO per debug)
# ============================================================
# Self-hosting: docker compose -f docker-compose.langfuse.yml up -d
# Poi genera le chiavi su http://localhost:3000
# Se non configurato, il tracing è disabilitato silenziosamente.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000

# ============================================================
# RAG
# ============================================================
# Soglie di punteggio del recupero. ATTENZIONE al nome: fino al refactor del
# config si chiamavano ERMES_SCORE_LOW / _MED. Chi ha ancora i vecchi nomi nel
# proprio .env continua a essere servito, e all'avvio viene avvisato di
# rinominarli — ma per un periodo quei nomi non avevano alcun effetto e la
# soglia restava silenziosamente al default.
ERMES_SCORE_THRESHOLD_LOW=0.35
ERMES_SCORE_THRESHOLD_MED=0.55
ERMES_SCORE_THRESHOLD_HIGH=0.75
ERMES_PROMPT_MAX_CHARS=2000
ERMES_LOG_RETENTION_DAYS=30

# ============================================================
# ADMIN
# ============================================================
ERMES_ADMIN_USERNAME=admin
# La password NON e' preimpostata qui a proposito. Questo file si copia in
# .env come primo passo del README, quindi qualunque valore scritto qui
# diventa la password reale dell'amministratore: fino al 10 settembre 2026
# c'era "CHANGE_ME" non commentata, e un'installazione appena clonata
# accettava admin/CHANGE_ME. Genera una credenziale casuale con
#   .\.venv-ermes\Scripts\python.exe scripts\provision_local_demo_auth.py --write
# oppure scrivine una tua qui sotto. Senza nessuna delle due, e senza
# ERMES_API_KEY o SSO, l'applicazione rifiuta di partire e dice quale
# variabile manca.
# ERMES_ADMIN_PASSWORD=
ERMES_ADMIN_MAX_UPLOAD_MB=50

# ============================================================
# FORMULA GENERATION
# ============================================================
# DISABILITATA per default per sicurezza
# Attivare esplicitamente: ERMES_ENABLE_FORMULA_GENERATION=1
# ERMES_ENABLE_FORMULA_GENERATION=0

# ============================================================
# BACKUP SCHEDULING
# ============================================================
# Backup automatico: abilitato (1) ogni 24 ore di default.
# Disabilita con ERMES_BACKUP_ENABLED=0
# ERMES_BACKUP_ENABLED=1
# ERMES_BACKUP_INTERVAL_HOURS=24

# ============================================================
# PII FILTERING (GDPR / Privacy)
# ============================================================
# Oscura automaticamente email, telefono, CF, IP, etc.
# dal contesto inviato all'LLM. Abilitato per default.
# ERMES_PII_FILTER_ENABLED=1

# ============================================================
# API SECURITY (RBAC)
# ============================================================
# Se vuoto, l'API key legacy è disabilitata.
# Puoi comunque creare utenti con API key via:
#   POST /api/users  (richiede ruolo admin)
#
# Se valorizzata, funge da "super admin" key legacy.
# Genera una key forte con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ERMES_API_KEY=incolla_qui_una_chiave_generata

# Login browser locale: obbligatorio se usi la UI senza Bearer API key.
# Non lasciare mai questa password vuota in un'installazione condivisa.
# ERMES_ADMIN_USERNAME e ERMES_ADMIN_PASSWORD si impostano nella sezione ADMIN
# piu' sopra: assegnarle due volte farebbe vincere l'ultima riga, e chi
# modifica la prima non otterrebbe niente senza capire perche'.
ERMES_SESSION_TTL_HOURS=12

# Origini browser autorizzate, separate da virgola. Aggiungi qui il dominio
# aziendale prima di esporre l'interfaccia fuori dalla macchina locale.
ERMES_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# AUDIT SECURITY
# ============================================================
# HMAC per integrità del registro di audit.
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
#
# LASCIALO COMMENTATO se non hai una chiave tua: in quel caso Ermes ne genera
# una casuale alla prima esecuzione e la salva in security/.audit_secret, che
# persiste ai riavvii. Un valore segnaposto viene invece rifiutato, perche'
# una chiave nota rende la firma inutile: chiunque abbia il repository
# potrebbe fabbricare voci di audit che risultano valide.
#
# Impostalo esplicitamente quando piu' istanze devono verificare le stesse
# voci, o quando la chiave e' gestita da un gestore di segreti.
# ERMES_AUDIT_SECRET=

# ============================================================
# EXTERNAL CHAT INTEGRATIONS (Teams / Slack / Telegram)
# ============================================================
# Dopo aver configurato, esegui:\
#   .\scripts\setup-integrations.ps1
# per automatizzare l'esposizione pubblica e la registrazione webhook.
#
# --- Microsoft Teams Outgoing Webhook ---
# 1. In un canale Teams: "..." > "Connettori" > "Outgoing Webhook" > "Aggiungi"
# 2. Nome: "Ermes", URL: "https://tuo-dominio/api/integrations/teams"
# 3. Inserisci un Secret e copialo qui sotto. NON e' opzionale: senza secret
#    nessuna richiesta e' verificabile come proveniente da Teams, e la rotta
#    rifiuta tutto con 503 invece di lasciar passare chiunque.
# ERMES_TEAMS_WEBHOOK_SECRET=CHANGE_ME
#
# --- Slack Slash Command (/ermes) ---
# 1. Vai su https://api.slack.com/apps > "Create New App" > "From scratch"
# 2. Features > "Slash Commands" > "Create New Command"
#    Comando: /ermes, URL richiesta: "https://tuo-dominio/api/integrations/slack"
#    Descrizione: "Cerca nei documenti della biblioteca collegata"
# 3. Settings > "Basic Information" > "App Credentials" > copia "Signing Secret"
# ERMES_SLACK_SIGNING_SECRET=CHANGE_ME
# (Opzionale) Per rispondere agli eventi in canale invece che ai soli comandi:
# OAuth & Permissions > "Bot User OAuth Token"
# ERMES_SLACK_BOT_TOKEN=CHANGE_ME
#
# --- Telegram Bot ---
# 1. Parla con @BotFather > /newbot > copia il token del bot
# ERMES_TELEGRAM_BOT_TOKEN=CHANGE_ME
# 2. Scegli un secret INDIPENDENTE dal token del bot (stringa casuale) e
#    registralo insieme al webhook:
#    curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://tuo-dominio/api/integrations/telegram&secret_token=<SECRET>"
#    Telegram lo rimanda nell'header X-Telegram-Bot-Api-Secret-Token, ed e'
#    l'unica cosa che autentica quella rotta: senza, la rotta rifiuta tutto.
#    Non usare qui il token del bot — puo' inviare messaggi a suo nome.
# ERMES_TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
# ============================================================
# ENTERPRISE SSO & IDENTITY (OIDC / Microsoft Entra ID / Keycloak / Okta)
# ============================================================
# Abilita il login SSO federato per gli utenti aziendali (0=disabilitato, 1=abilitato)
# ERMES_OIDC_ENABLED=1
# ERMES_OIDC_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
# ERMES_OIDC_CLIENT_ID=your-azure-app-client-id
# ERMES_OIDC_CLIENT_SECRET=your-azure-app-client-secret
# ERMES_OIDC_AUDIENCE=your-azure-app-client-id
# Claim per estrarre i ruoli utente (default: roles)
# ERMES_OIDC_ROLES_CLAIM=roles
# Chiavi pubbliche con cui si verifica la firma dei token. Se lasciato vuoto
# vengono scoperte da ERMES_OIDC_ISSUER via /.well-known/openid-configuration:
# valorizzalo solo se il provider non espone il discovery o se lo raggiungi a
# un indirizzo interno diverso. Senza ne' JWKS ne' issuer nessun token puo'
# essere verificato, e vengono tutti rifiutati.
# ERMES_OIDC_JWKS_URL=https://login.microsoftonline.com/your-tenant-id/discovery/v2.0/keys

# ============================================================
# ENTERPRISE CONTEXTUAL RERANKER
# ============================================================
# Ri-ordina i chunk recuperati per tentare di migliorare la precisione.
# DISATTIVATO di default per una misura, non per una preferenza: sul golden
# set del progetto peggiora ogni configurazione (recall@3 0.815 contro 0.852,
# parafrasi 0.375 contro 0.500). Riproducibile con
#   python evaluation/run_library_eval.py --compare
# Su un corpus reale potrebbe comportarsi diversamente: misura prima di
# riaccenderlo.
# ERMES_RERANKER_ENABLED=0
# Soglia minima di rilevanza normalizzata per includere un passaggio nel prompt (0.0 - 1.0)
# ERMES_RERANKER_MIN_SCORE=0.15

# ============================================================
# RERANKER NEURALE (cross-encoder)
# ============================================================
# Richiede l'extra: pip install .[neural] (sentence-transformers + torch).
# Senza l'extra il sistema ripiega automaticamente sul reranker lessicale.
# Modello HuggingFace (scaricato in cache locale al primo avvio, ~90MB)
# ERMES_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Disattivazione del solo reranking neurale (0 = solo lessicale)
# ERMES_RERANKER_NEURAL=1

# ============================================================
# CACHE DI RICERCA (in memoria, per utente)
# ============================================================
# TTL delle entry in secondi (0 disattiva la cache)
# ERMES_SEARCH_CACHE_TTL_SECONDS=300
# Numero massimo di entry (LRU eviction oltre il limite)
# ERMES_SEARCH_CACHE_MAX_ENTRIES=200

# ============================================================
# DATABASE BACKEND (SQLite di default)
# ============================================================
# Vuoto = SQLite locale (nessuna configurazione necessaria).
# Per il deploy multi-utente con il profilo "postgres" di docker-compose:
#   docker compose --profile postgres up -d
# e decommentare la URL (la password deve combaciare con POSTGRES_PASSWORD):
# ERMES_DATABASE_URL=postgresql://ermes:ermes_change_me@postgres:5432/ermes

# Password del container PostgreSQL del profilo "postgres" (CAMBIARE!)
# POSTGRES_PASSWORD=ermes_change_me
# POSTGRES_USER=ermes
# POSTGRES_DB=ermes

# ============================================================
# METRICS (Prometheus)
# ============================================================
# Token per accedere a /metrics via Bearer. Vuoto = solo admin autenticato.
# ERMES_METRICS_TOKEN=change-me-random-token

# ============================================================
# ENTERPRISE DATA LOSS PREVENTION (DLP) & GDPR
# ============================================================
# Maschera proattivamente IBAN, Carte di Credito (Luhn), Codici Fiscali, JWT e API Keys
# ERMES_PII_FILTER_ENABLED=1
# Registra violazioni DLP nel log di audit (1=attivo)
# ERMES_DLP_AUDIT_ENABLED=1

# ============================================================
# ENTERPRISE CLOUD CONNECTORS (SharePoint / Google Drive)
# ============================================================
# Configurazione connettore Microsoft SharePoint / OneDrive:
# MS_GRAPH_TENANT_ID=your-tenant-id
# MS_GRAPH_CLIENT_ID=your-client-id
# MS_GRAPH_CLIENT_SECRET=your-client-secret
# MS_GRAPH_DRIVE_ID=your-drive-id


# ============================================================
# PROTEZIONE ACCESSI
# ============================================================
# Tentativi di accesso falliti tollerati prima del blocco temporaneo.
# Il conteggio e' per indirizzo IP e per coppia IP+username, mai per solo
# username: bloccare un account da qualunque provenienza permetterebbe a
# chiunque ne conosca il nome di lasciare fuori un collega.
# ERMES_LOGIN_MAX_ATTEMPTS=10
# ERMES_LOGIN_LOCKOUT_MINUTES=15

# ============================================================
# LOGGING
# ============================================================
# text (default) = leggibile a schermo durante lo sviluppo.
# json           = un evento per riga con campi separati, che e' cio' che un
#                  aggregatore aziendale (SIEM, Loki, Elastic) sa interrogare.
#                  E' gia' il default dentro Docker.
# ERMES_LOG_FORMAT=text
# ERMES_LOG_LEVEL=INFO

# ============================================================
# VERIFICA DELL'EVIDENZA
# ============================================================
# Chiede a un modello se il passaggio recuperato risponda davvero alla
# domanda, invece di fidarsi del solo punteggio di similarita'. E' l'unico
# meccanismo misurato che migliora le parafrasi senza azzerare l'astensione:
# sul golden set porta recall@3 da 0.852 a 0.889 con astensione a 1.000.
# Vedi docs/RETRIEVAL_EVALUATION.md.
#
# Spento di default: costa una chiamata al modello per passaggio candidato
# (fino a tre per domanda) e richiede un modello raggiungibile, che nella
# modalita' evidence_only non c'e' per scelta. Ha senso attivarlo insieme a
# ERMES_LIBRARY_SEMANTIC_SEARCH=1.
# ERMES_EVIDENCE_VERIFIER=1
# Vuoto = usa ERMES_MODEL. Un modello piccolo basta: 4b e 9b danno lo stesso
# risultato sul golden set.
# ERMES_EVIDENCE_VERIFIER_MODEL=qwen3.5:4b
