# ============================================================
# .gitignore — Ermes - Enterprise Knowledge Hub
# ============================================================

# ── Dati generati a runtime (non versionare mai) ────────────
chroma_db/
logs/
backups/
security/
*.bak

# ── Documenti utente (dati aziendali, non nel repo) ─────────
documenti/
storage/
data/ermes_knowledge.sqlite3

# ── Ambiente virtuale Python ────────────────────────────────
venv/
.venv/
.venv-ermes/
env/

# ── Cache Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Cache modelli HuggingFace ──────────────────────────────
.embed_cache/
# ── Variabili d'ambiente e segreti ──────────────────────────
# `.env.*` copre ogni variante presente e futura (.env.test, .env.staging...).
# La regola precedente elencava i nomi uno per uno piu' `*.env`, che matcha solo
# i file che *finiscono* in `.env`: un `.env.test` restava tracciabile.
.env
.env.*
!.env.example
*.env
LOCAL_LOGIN.txt
config/providers.json

# ── Documenti personali / scansioni ─────────────────────────
# Questo repository ha gia' avuto un documento riservato committato per errore
# e rimosso dall'intera cronologia. Le scansioni non entrano mai nel repository.
Adobe Scan*.pdf
*.scan.pdf

# ── Editor e OS ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ── File temporanei e di build ───────────────────────────────
*.tmp
*.log
dist/
build/
*.egg-info/
node_modules/
frontend/node_modules/
frontend/dist/
coverage/
.coverage

# ── Script di debug temporanei ──────────────────────────────
fix_*.py
check_*.py
debug_*.py
