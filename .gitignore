# ============================================================
# .gitignore — Ermes - Enterprise Knowledge Hub
# ============================================================

# ── Dati generati a runtime (non versionare mai) ────────────
chroma_db/
logs/
backups/
security/
*.bak

# ── Documenti utente (dati aziendali, non nel repo) ─────────
documenti/
storage/
data/ermes_knowledge.sqlite3

# ── Ambiente virtuale Python ────────────────────────────────
venv/
.venv/
.venv-ermes/
env/

# ── Cache Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Cache modelli HuggingFace ──────────────────────────────
.embed_cache/
# ── Variabili d'ambiente e segreti ──────────────────────────
.env
.env.local
.env.development
.env.production
*.env
LOCAL_LOGIN.txt
config/providers.json

# ── Editor e OS ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ── File temporanei e di build ───────────────────────────────
*.tmp
*.log
dist/
build/
*.egg-info/
node_modules/
frontend/node_modules/
frontend/dist/
coverage/
.coverage

# ── Script di debug temporanei ──────────────────────────────
fix_*.py
check_*.py
debug_*.py
