        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ermes_rag_retrieval_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Retrieval p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(ermes_rag_retrieval_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Retrieval p50",
          "refId": "B"
        }
      ],
      "title": "Durata Fase di Retrieval (BM25 + Vettoriale)",
      "type": "timeseries"
