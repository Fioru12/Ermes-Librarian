        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(sum(ermes_rag_questions_total{outcome=\"abstained\"}) or vector(0)) / (sum(ermes_rag_questions_total) or vector(1)) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Tasso di Astensione (Evidence-First)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
